# Copy to .env and fill in what you need. .env is git-ignored: never commit real values.
# Load into your shell with:  set -a; source .env; set +a

# --- Anthropic -------------------------------------------------------------
# ANTHROPIC_API_KEY=<your-key>           # leave commented to use your Claude Code login (Agent SDK)
TRIAGE_MODEL=claude-sonnet-5-5            # any model id your key can use

# --- AWS (use a named profile; never put access keys here) ------------------
# AWS_PROFILE=your-profile             # an EMPTY value breaks boto3: keep commented if unused
AWS_REGION=us-east-1

# --- QA data (shared/) ------------------------------------------------------
DDB_ENDPOINT=http://localhost:8000        # DynamoDB Local; set to "aws" to use real DynamoDB
QA_TABLE=crash-qa
QA_REPORTS_BUCKET=                        # your S3 bucket for run reports (bucket names are global)
QA_VECTOR_BUCKET=                         # your S3 Vectors bucket
QA_VECTOR_INDEX=qa-docs
SERVER_PYTHON=shared/mcp-server/.venv/bin/python   # interpreter that agents use to start the MCP server

# --- Slack (Socket Mode app) ------------------------------------------------
SLACK_BOT_TOKEN=                          # xoxb-...
SLACK_APP_TOKEN=                          # xapp-... (connections:write)
SLACK_WEBHOOK_URL=                        # incoming webhook, for one-way notifications
APPROVER_IDS=                             # comma-separated Slack user IDs allowed to approve bugs

# --- Jira (leave empty for dry-run: proposals get DRYRUN-xxxxxx keys) --------
JIRA_BASE_URL=                            # https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=QA

# --- Bedrock AgentCore (05) --------------------------------------------------
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=
BEDROCK_MODEL_ID=
